generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int          @id @default(autoincrement())
  nombre       String
  email        String       @unique
  password     String
  rol          Rol
  vehiculos    Vehiculo[]
  inspecciones Inspeccion[] @relation("Inspector")
}

model Vehiculo {
  id        Int     @id @default(autoincrement())
  matricula String  @unique
  marca     String?
  modelo    String?
  anio      Int?
  duenio    Usuario @relation(fields: [duenioId], references: [id])
  duenioId  Int
  turnos    Turno[]
}

model Turno {
  id         Int         @id @default(autoincrement())
  vehiculo   Vehiculo    @relation(fields: [vehiculoId], references: [id])
  vehiculoId Int
  fechaHora  DateTime
  confirmado Boolean     @default(false)
  estado     String      @default("PENDIENTE")
  inspeccion Inspeccion?
}

model Inspeccion {
  id          Int             @id @default(autoincrement())
  turno       Turno           @relation(fields: [turnoId], references: [id])
  turnoId     Int             @unique
  inspector   Usuario         @relation("Inspector", fields: [inspectorId], references: [id])
  inspectorId Int
  totalPuntos Int
  resultado   String
  observacion String?
  items       ItemResultado[]
}

model ChequeoItem {
  id          Int             @id @default(autoincrement())
  nombre      String
  descripcion String?
  orden       Int
  items       ItemResultado[]
}

model ItemResultado {
  id            Int         @id @default(autoincrement())
  inspeccion    Inspeccion  @relation(fields: [inspeccionId], references: [id])
  inspeccionId  Int
  chequeoItem   ChequeoItem @relation(fields: [chequeoItemId], references: [id])
  chequeoItemId Int
  puntaje       Int
}

enum Rol {
  DUENIO
  INSPECTOR
  ADMIN
}
